{
  "name": "Bot de Telegram - eco",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "7e1e0001-0000-4000-8000-000000000001",
      "name": "Llega un Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "webhookId": "7e1e0001-0000-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7d000001-0000-4000-8000-000000000001",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "7d000001-0000-4000-8000-000000000002",
              "name": "texto",
              "value": "={{ $json.message.text || '' }}",
              "type": "string"
            },
            {
              "id": "7d000001-0000-4000-8000-000000000003",
              "name": "nombre",
              "value": "={{ $json.message.from.first_name || '' }}",
              "type": "string"
            },
            {
              "id": "7d000001-0000-4000-8000-000000000004",
              "name": "usuario",
              "value": "={{ $json.message.from.username || '' }}",
              "type": "string"
            },
            {
              "id": "7d000001-0000-4000-8000-000000000005",
              "name": "tipo_chat",
              "value": "={{ $json.message.chat.type }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "7e1e0001-0000-4000-8000-000000000002",
      "name": "Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "7c000001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.texto }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "7c000001-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.tipo_chat }}",
              "rightValue": "private",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7e1e0001-0000-4000-8000-000000000003",
      "name": "¿Es un mensaje para contestar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Datos').item.json.chat_id }}",
        "text": "={{ $('Datos').item.json.texto === '/start' ? '👋 ¡Hola ' + $('Datos').item.json.nombre + '! Escribime algo y te contesto.' : '🤖 Recibí tu mensaje: ' + $('Datos').item.json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "7e1e0001-0000-4000-8000-000000000004",
      "name": "Contestar por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, -100]
    }
  ],
  "connections": {
    "Llega un Telegram": {
      "main": [[{ "node": "Datos", "type": "main", "index": 0 }]]
    },
    "Datos": {
      "main": [[{ "node": "¿Es un mensaje para contestar?", "type": "main", "index": 0 }]]
    },
    "¿Es un mensaje para contestar?": {
      "main": [
        [{ "node": "Contestar por Telegram", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
